{UTF-8}

潜在购买者 = INTEG(0 - 新车购买, 1000000)
	~ 辆
	~
	|

汽车保有量 = INTEG(新车购买 - 车辆报废, 10000)
	~ 辆
	~
	|

充电桩数量 = INTEG(充电桩建设 - 充电桩淘汰, 2000)
	~ 个
	~
	|

新车购买 = 潜在购买者 * 购买意愿
	~ 辆/Year
	~
	|

车辆报废 = 汽车保有量 / 车辆寿命
	~ 辆/Year
	~
	|

充电桩建设 = 充电桩缺口 / 建设周期
	~ 个/Year
	~
	|

充电桩淘汰 = 充电桩数量 / 充电桩寿命
	~ 个/Year
	~
	|

购买意愿 = 基础购买率 * 充电便利性 * (1 + 补贴效应) * 口碑效应
	~ 1/Year
	~
	|

口碑效应 = 1 + 口碑系数 * 汽车保有量 / 市场规模
	~ Dmnl
	~
	|

补贴效应 = 购车补贴 / 车辆价格
	~ Dmnl
	~
	|

充电便利性 = MIN(1, 充电桩数量 / 充电桩需求)
	~ Dmnl
	~
	|

充电桩需求 = 汽车保有量 / 车桩比
	~ 个
	~
	|

充电桩缺口 = MAX(0, 充电桩需求 - 充电桩数量)
	~ 个
	~
	|

市场渗透率 = 汽车保有量 / 市场规模
	~ Dmnl
	~
	~	:SUPPLEMENTARY
	|

基础购买率 = 0.01
	~ 1/Year
	~
	|

口碑系数 = 2
	~ Dmnl
	~
	|

市场规模 = 1010000
	~ 辆
	~
	|

购车补贴 = 20000
	~ 元/辆
	~
	|

车辆价格 = 150000
	~ 元/辆
	~
	|

车桩比 = 3
	~ 辆/个
	~
	|

车辆寿命 = 10
	~ Year
	~
	|

建设周期 = 2
	~ Year
	~
	|

充电桩寿命 = 8
	~ Year
	~
	|

INITIAL TIME = 0
	~ Year
	~
	|

FINAL TIME = 30
	~ Year
	~
	|

TIME STEP = 0.25
	~ Year
	~
	|

SAVEPER = 1
	~ Year
	~
	|

