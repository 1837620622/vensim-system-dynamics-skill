{UTF-8}

库存 = INTEG(补货 - 销售, 初始库存)
	~ 件
	~
	|

补货 = MAX(0, 需求 + (目标库存 - 库存) / 调整时间)
	~ 件/Month
	~
	|

销售 = MIN(需求, 库存 / 发货时间)
	~ 件/Month
	~
	|

需求 = 20
	~ 件/Month
	~
	|

目标库存 = 200
	~ 件
	~
	|

调整时间 = 4
	~ Month
	~
	|

发货时间 = 1
	~ Month
	~
	|

初始库存 = 100
	~ 件
	~
	|

INITIAL TIME = 0
	~ Month
	~
	|

FINAL TIME = 60
	~ Month
	~
	|

TIME STEP = 0.25
	~ Month
	~
	|

SAVEPER = 1
	~ Month
	~
	|

